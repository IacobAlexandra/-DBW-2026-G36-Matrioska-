<%- include('partials/head') %>
    <div class="container game-container">
        <h1 class="master-word-title cr-title">Room Code: <span id="room-code">[ROOM_CODE]</span></h1>
        
        <p class="cr-waiting">Waiting for players...</p>

        <div class="game-main cr-main">
            <div class="left-panel cr-left">
                <h2 class="cr-h2">Players in room:</h2>
                
                <ul class="cr-ul">
                    <li class="cr-li">
                        <span class="profile-icon cr-avatar"></span>
                        1. PlayerOne <span class="cr-sub">(you)</span>
                    </li>
                    <li class="cr-li">
                        <span class="profile-icon cr-avatar"></span>
                        2. PlayerTwo
                    </li>
                </ul>
            </div>

            <div class="right-panel cr-right">
                <div class="text-center">
                    <a href="/game/multiplayer/play" class="btn btn-submit btn-no-margin w-100 btn-submit-flex">Start Game</a>
                    <p class="cr-status">Status: Waiting for game to start</p>
                </div>
                
                <a href="/game/multiplayer" class="btn btn-secondary btn-submit btn-no-margin w-100">Leave Room</a>
            </div>
        </div>
    </div>
</body>
</html>
