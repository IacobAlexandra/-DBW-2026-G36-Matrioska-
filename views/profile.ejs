<%- include('partials/head') %>
    <div class="container profile-wrapper">
        <div class="mp-top-right">
            <a href="/menu" class="btn btn-small">Back to Menu</a>
        </div>

        <div class="game-main" style="align-items: center; justify-content: center; width: 100%; margin-top: 1rem;">
            <div class="left-panel flex-center" style="flex-direction: column;">
                <div class="profile-avatar" style="background-color: var(--input-bg); border-radius: 50%; background-image: url('data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%23999\'><path d=\'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\'/></svg>'); background-size: 80%; background-position: center; background-repeat: no-repeat; box-shadow: 0 4px 6px rgba(0,0,0,0.1);"></div>
                <a href="#" class="profile-change-pic">Change Profile Picture</a>
                <h1 class="profile-username">[username]</h1>
            </div>

            <div class="right-panel flex-center" style="flex-direction: column; justify-content: center;">
                <div class="statistics-section profile-stats-box" style="margin-top: 0; max-width: 500px;">
                    <h2 class="profile-stats-title">Statistics</h2>
                    <div class="profile-stats-grid">
                        <p>Total Score: <span class="font-bold">___</span></p>
                        <p>Correct Words: <span class="font-bold">___</span></p>
                        <p>Total Time Played: <span class="font-bold">___</span></p>
                        <p>Wrong Words: <span class="font-bold">___</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
