<%- include('partials/head') %>
    <div class="container profile-wrapper">
        <div class="mp-top-right">
            <a href="/menu" class="btn btn-small">Back to Menu</a>
        </div>

        <div class="game-main" style="align-items: center; justify-content: center; width: 100%; margin-top: 1rem;">
            <div class="left-panel flex-center" style="flex-direction: column;">
                <% if (user.profilePic) { %>
                    <div class="profile-avatar" style="background-image: url('<%= user.profilePic %>'); background-size: cover; background-position: center; border-radius: 50%; box-shadow: 0 4px 6px rgba(0,0,0,0.1);"></div>
                <% } else { %>
                    <div class="profile-avatar" style="background-color: var(--input-bg); border-radius: 50%; background-image: url('data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%23999\'><path d=\'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\'/></svg>'); background-size: 80%; background-position: center; background-repeat: no-repeat; box-shadow: 0 4px 6px rgba(0,0,0,0.1);"></div>
                <% } %>
                
                <form action="/profile/upload" method="POST" enctype="multipart/form-data" style="margin-top: 1rem; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
                    <label for="avatar" class="profile-change-pic" style="cursor: pointer; margin: 0;">Change Profile Picture</label>
                    <input type="file" name="avatar" id="avatar" accept="image/*" style="display: none;" onchange="this.form.submit()">
                </form>
                
                <h1 class="profile-username" style="margin-top: 1rem;"><%= user.username %></h1>
            </div>

            <div class="right-panel flex-center" style="flex-direction: column; justify-content: center;">
                <div class="statistics-section profile-stats-box" style="margin-top: 0; max-width: 500px;">
                    <h2 class="profile-stats-title">Statistics</h2>
                    <div class="profile-stats-grid">
                        <p>Total Score: <span class="font-bold"><%= user.score %></span></p>
                        <p>Correct Words: <span class="font-bold"><%= user.foundWords %></span></p>
                        <p>Total Time Played: <span class="font-bold"><%= Math.floor(user.playTime / 60) %> min</span></p>
                        <p>Wrong Words: <span class="font-bold"><%= user.wrongWords %></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include('partials/footer') %>
