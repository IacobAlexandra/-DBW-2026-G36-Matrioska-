<%- include('partials/head') %>
    <div class="game-container container">
        <div class="game-header">
            <div class="timer">Timer: <span id="time-left"><%= timeLimit %></span> seconds left</div>
            <button id="exit-btn" class="btn btn-small">Exit Game</button>
        </div>

        <h1 class="master-word-title">Master Word: <i id="master-word"><%= word %></i> </h1>

        <div class="game-main">

            <div class="left-panel">
                <div class="score-board">
                    <p>Score: <span id="score">0</span></p>
                    <p>Wrong Words: <span id="wrong">0</span></p>
                    <p>Correct Words: <span id="correct">0</span></p>
                </div>
            </div>

            <div class="center-panel">
                <label for="guess" class="enter-word-label">Enter word:</label>
                <input type="text" id="guess" class="guess-input" autocomplete="off">
                <button class="btn btn-no-margin" id="submit-btn">Submit</button>

                 <p id="feedback-msg"></p>
            </div>

            <div class="right-panel">
                <div class="words-found-box">
                    <h2>Words Found:</h2>
                    <ol id="found-words-list" class="found-words-list"> </ol>
                </div>
            </div>
        </div>
    </div>
    
    <script> 
        window.masterWord = "<%= word %>";
        window.timeLimit = "<%= timeLimit %>";
    </script>
    <script src="/js/singleplayer_game.js"></script>
</body>
</html>
