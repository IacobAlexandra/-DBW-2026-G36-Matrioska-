<%- include('partials/head') %>
    <div class="container game-container mp-game-container">
        <div class="mp-top-right">
            <a href="/menu" class="btn btn-small mp-exit-btn">Exit Game</a>
        </div>
        <div class="mp-timer-wrapper">
            <span class="mp-timer-text">Timer: x seconds left</span>
        </div>

        <h1 class="master-word-title mp-master-word">Master Word: SOLIDADERIEDADE</h1>

        <div class="game-main mp-game-main">
            <div class="left-panel flex-1">
                <h3 class="mp-sb-title">Scoreboard:</h3>
                <div class="mp-sb-box">
                    <ul class="mp-sb-ul">
                        <li class="mp-sb-li">
                            <div class="profile-icon mp-avatar-sm"></div>
                            1. Username <span class="mp-sb-sub">(you): xyz points</span>
                        </li>
                        <li class="mp-sb-li">
                            <div class="profile-icon mp-avatar-sm"></div>
                            2. Username: yxz points
                        </li>
                        <li class="mp-sb-li">
                            <div class="profile-icon mp-avatar-sm"></div>
                            3. Username: zyx points
                        </li>
                    </ul>
                </div>
            </div>

            <div class="center-panel">
                <label class="enter-word-label">Enter word:</label>
                <input type="text" class="guess-input">
                <a href="/game/multiplayer/gameover" class="btn">Submit</a>
            </div>

            <div class="right-panel mp-right-panel">
                <div class="words-found-box mp-words-box">
                    <h3 class="mp-wb-title">Words Found:</h3>
                    <ol class="found-words-list mp-wb-list">
                        <li>SOL <span class="mp-wb-pts">(x pts)</span></li>
                        <li>LIDA <span class="mp-wb-pts">(y pts)</span></li>
                        <li>IDA <span class="mp-wb-pts">(z pts)</span></li>
                    </ol>
                    <p class="mp-wb-undiscovered">[x] undiscovered words</p>
                </div>
                
                <div class="mp-stats-wrapper">
                    <p class="mp-stat-p">Score: 0</p>
                    <p class="mp-stat-p">Wrong Words: 0</p>
                    <p class="mp-stat-p">Correct Words: 0</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
