<%- include('partials/head') %>
    <div class="container game-container go-mp-container">
        <h1 class="master-word-title go-mp-title">Game Over</h1>
        
        <div class="game-main go-mp-main">
            <div class="left-panel go-mp-left">
                <h2 class="go-mp-score">Final Score: 15</h2>
                <p class="go-mp-stat">Correct Words: 5</p>
                <p class="go-mp-stat">Wrong Words: 2</p>

                <div class="go-mp-btns">
                    <a href="/game/multiplayer/play" class="btn btn-submit btn-no-margin">Play Again</a>
                </div>
            </div>

            <div class="center-panel go-mp-center">
                <h3 class="go-sb-title">Scoreboard:</h3>
                <div class="go-sb-box">
                    <ul class="go-sb-ul">
                        <li class="go-sb-li">
                            <div class="profile-icon go-avatar-md"></div>
                            1. Username <span class="go-sb-sub">(you): xyz points</span>
                        </li>
                        <li class="go-sb-li">
                            <div class="profile-icon go-avatar-md"></div>
                            2. Username: yxz points
                        </li>
                        <li class="go-sb-li">
                            <div class="profile-icon go-avatar-md"></div>
                            3. Username: zyx points
                        </li>
                    </ul>
                </div>

                <div class="go-bk-menu">
                    <a href="/menu" class="btn btn-submit btn-no-margin">Back to Menu</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
